  "definition": {
    "tool_id": "tool_books_toscrape_books",
    "name": "Book List Scraper",
    "description": "Extracts every book on the page with title, price, stock status, and star rating into a table.",
    "category": "data",
    "url_pattern": "https://books.toscrape.com/*",
    "version": 1,
    "steps": [
      {
        "type": "extract",
        "selector": "article.product_pod",
        "mode": "list",
        "fields": {
          "price": "p.price_color",
          "rating": "p.star-rating",
          "stock": "p.instock",
          "title": "h3 > a"
        },
        "field_types": {
          "price": "text",
          "rating": "attr",
          "stock": "text",
          "title": "attr"
        },
        "field_attrs": {
          "rating": "class",
          "title": "title"
        },
        "output_to": "raw_items"
      },
      {
        "type": "render",
        "input_from": "raw_items",
        "view": "table"
      }
    ],
    "created_at": "2026-10-30T00:00:00.000Z",
    "updated_at": "2026-10-30T00:00:00.000Z"
  },
