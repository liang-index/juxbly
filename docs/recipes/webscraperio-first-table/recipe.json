  "definition": {
    "tool_id": "tool_5c1e9a",
    "name": "First Table Rows",
    "description": "Extracts each row of the first table with its number, first name, last name and username.",
    "category": "data",
    "url_pattern": "https://webscraper.io/test-sites/tables",
    "version": 1,
    "steps": [
      {
        "type": "extract",
        "selector": "table:nth-of-type(1) tbody tr",
        "mode": "list",
        "fields": {
          "first_name": "td:nth-of-type(2)",
          "last_name": "td:nth-of-type(3)",
          "row_number": "td:nth-of-type(1)",
          "username": "td:nth-of-type(4)"
        },
        "field_types": {
          "first_name": "text",
          "last_name": "text",
          "row_number": "text",
          "username": "text"
        },
        "output_to": "raw_items"
      },
      {
        "type": "render",
        "input_from": "raw_items",
        "view": "table"
      }
    ],
