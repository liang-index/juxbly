{
  "name": "juxbly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @juxbly/extension dev",
    "build": "pnpm --filter @juxbly/extension build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && node apps/playground/e2e/lifecycle.mjs",
    "test:corpus": "node scripts/check-corpus.mjs",
    "test:bench": "node scripts/stage-placeholder.mjs 2-3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "playwright": "1.63.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@vitejs/plugin-react": "^5.2.0"
    }
  }
}
