// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CardView > matches its snapshot 1`] = `"<div class="jx-view"><div class="jx-cards jx-view-scroll"><div class="jx-card"><div class="jx-card-field"><span class="jx-card-key">title</span><span class="jx-card-value">Wireless keyboard</span></div><div class="jx-card-field"><span class="jx-card-key">price</span><span class="jx-card-value">49</span></div><div class="jx-card-field"><span class="jx-card-key">url</span><span class="jx-card-value"><a class="jx-link" href="https://example.com/keyboard" target="_blank" rel="noreferrer noopener">https://example.com/keyboard</a></span></div></div><div class="jx-card"><div class="jx-card-field"><span class="jx-card-key">title</span><span class="jx-card-value">Wireless mouse</span></div><div class="jx-card-field"><span class="jx-card-key">price</span><span class="jx-card-value">29</span></div><div class="jx-card-field"><span class="jx-card-key">url</span><span class="jx-card-value"><a class="jx-link" href="https://example.com/mouse" target="_blank" rel="noreferrer noopener">https://example.com/mouse</a></span></div></div></div></div>"`;

exports[`TableView > matches its snapshot 1`] = `"<div class="jx-view"><div class="jx-view-scroll"><table class="jx-table"><thead><tr><th scope="col">title</th><th scope="col">price</th><th scope="col">url</th></tr></thead><tbody><tr><td>Wireless keyboard</td><td>49</td><td><a class="jx-link" href="https://example.com/keyboard" target="_blank" rel="noreferrer noopener">https://example.com/keyboard</a></td></tr><tr><td>Wireless mouse</td><td>29</td><td><a class="jx-link" href="https://example.com/mouse" target="_blank" rel="noreferrer noopener">https://example.com/mouse</a></td></tr></tbody></table></div></div>"`;

exports[`TextView > matches its snapshot 1`] = `"<div class="jx-view"><div class="jx-text-view jx-view-scroll"><p class="jx-text-row">title: Wireless keyboard · price: 49 · url: https://example.com/keyboard</p><p class="jx-text-row">title: Wireless mouse · price: 29 · url: https://example.com/mouse</p></div></div>"`;
